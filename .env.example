# Example environment variables for Ententia IDP
# Copy this file to .env and replace placeholder values as needed.

PORT=8000
ENTENTIA_IDP_AWS_REGION=us-east-1
ENTENTIA_IDP_AWS_PROFILE_NAME=example-profile
ENTENTIA_IDP_BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-1:000000000000:inference-profile/example-model
ENTENTIA_IDP_BEDROCK_MAX_TOKENS=4096
ENTENTIA_IDP_CACHE_DIR=${HOME}/.cache/ententia-idp
ENTENTIA_IDP_REQUEST_TIMEOUT_SECONDS=120
GRAFANA_CLOUD_PROMETHEUS_URL=https://example.grafana.com/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=example_user
GRAFANA_CLOUD_PROMETHEUS_PASSWORD=example_password
